  STUDENT
  ADVISOR
  ADMIN
}

enum DegreeLevel {
  BACCALAUREATE
  MASTERS
  DOCTORAL
  CERTIFICATE
}

enum TermSeason {
  FALL
  SPRING
  SUMMER
  SUMMER_I
  SUMMER_II
}

enum Grade {
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  D_PLUS
  D
  F
  W
  I
