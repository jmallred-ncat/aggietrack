model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bannerId String? @unique

  catalogYearId String
  catalogYear   CatalogYear @relation(fields: [catalogYearId], references: [id])

  advisorId String?
  advisor   User?   @relation("AdvisorToStudents", fields: [advisorId], references: [id])

  expectedGradTermId String?
  expectedGradTerm   AcademicTerm? @relation("ExpectedGraduation", fields: [expectedGradTermId], references: [id])

  /// The semester in session the student said they are not taking courses in.
  notTakingTermId String?
  notTakingTerm   AcademicTerm? @relation("NotTakingTerm", fields: [notTakingTermId], references: [id], onDelete: SetNull)

  /// Set when prior coursework is recorded, or the student says they have none.
  startConfirmedAt DateTime?

  /// Class status the catalog uses, such as the sophomore status CST 231 requires.
  standing StudentStanding?

  transcript   TranscriptEntry[]
  plannedTerms PlannedTerm[]
  appointments AdvisingAppointment[]
  notes        AdvisingNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advisorId])
  @@index([catalogYearId])
}

model TranscriptEntry {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /// Free-elective identity when the course is not in the catalog.
  subject String?
  number  String?
  title   String?

  termId String?
  term   AcademicTerm? @relation(fields: [termId], references: [id])

  grade             Grade?
  status            TranscriptStatus
  source            TranscriptSource @default(NCAT)
  credits           Int
  sourceInstitution String?
  /// Placeholder row this credit fills. Null when the course is a named plan requirement.
  recommendedTermCourseId String?
  recommendedTermCourse   RecommendedTermCourse? @relation(fields: [recommendedTermCourseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([courseId])
  @@index([recommendedTermCourseId])
}

/// One registration term a student submits for an advisor to review.
model PlannedTerm {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      AcademicTerm   @relation(fields: [termId], references: [id])

  status          PlannedTermStatus @default(DRAFT)
  registrationPin String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  /// Set when the student records these courses as in progress after registering.
  registeredAt    DateTime?

  courses PlannedCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
  @@index([studentId])
  @@index([status])
}

model PlannedCourse {
  id            String      @id @default(cuid())
  plannedTermId String
  plannedTerm   PlannedTerm @relation(fields: [plannedTermId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plannedTermId, courseId])
  @@index([courseId])
}
