model Degree {
  id           String      @id @default(cuid())
  name         String      @unique // "Bachelor of Science"
  abbreviation String      @unique // "B.S."
  level        DegreeLevel
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)

  programs Program[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, isActive])
}

model Department {
  id           String  @id @default(cuid())
  name         String  @unique // "Computer Systems Technology"
  abbreviation String  @unique // "CST"
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  programs Program[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Program {
  id           String  @id @default(cuid())
  code         String  @unique // "0432"
  shortName    String? // "INFO", "ELET"
  name         String // "Information Technology"
  totalCredits Int     @default(120)

  degreeId String
  degree   Degree @relation(fields: [degreeId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  catalogYears CatalogYear[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, degreeId])
  @@index([degreeId])
  @@index([departmentId])
  @@index([shortName])
}

model CatalogYear {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])
  year      Int // 2020; unique start year for this program's catalog

  students    StudentProfile[]
  groups      RequirementGroup[]
  attributes  CourseAttribute[]
  recommended RecommendedTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, year])
}

model RequirementGroup {
  id            String      @id @default(cuid())
  catalogYearId String
  catalogYear   CatalogYear @relation(fields: [catalogYearId], references: [id], onDelete: Cascade)

  name             String
  slot             RequirementSlot
  minCredits       Int
  minGrade         Grade?
  sortOrder        Int
  /// Subject rule for a group that has no course list, such as CST technical electives.
  subject          String?
  minNumber        Int? // 100 for free electives
  /// GEC category this pool consumes. Null on non-gen-ed slots.
  genEdCategory    GenEdTag?
  /// Extra qualifier on the same pool (e.g. lab) so constraints don't add groups.
  requiredGenEdTag GenEdTag?

  items         RequirementItem[]
  recommendedIn RecommendedTermCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([catalogYearId, genEdCategory])
  @@index([catalogYearId, slot])
}

model RequirementItem {
  id       String           @id @default(cuid())
  groupId  String
  group    RequirementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId String
  course   Course           @relation(fields: [courseId], references: [id])

  @@unique([groupId, courseId])
}

model RecommendedTerm {
  id            String                  @id @default(cuid())
  catalogYearId String
  catalogYear   CatalogYear             @relation(fields: [catalogYearId], references: [id], onDelete: Cascade)
  /// 1 = freshman fall. Odd sequences are fall; even sequences are spring.
  sequence      Int
  courses       RecommendedTermCourse[]

  @@unique([catalogYearId, sequence])
}

model RecommendedTermCourse {
  id                 String            @id @default(cuid())
  termId             String
  term               RecommendedTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
  /// Set for a named course. Null when the guide only names a requirement group.
  courseId           String?
  course             Course?           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// Set for an undecided slot (gen-ed, elective). Null when courseId is set.
  requirementGroupId String?
  requirementGroup   RequirementGroup? @relation(fields: [requirementGroupId], references: [id], onDelete: Cascade)
  sortOrder          Int               @default(0)

  transcriptEntries TranscriptEntry[]

  @@unique([termId, courseId])
  @@index([requirementGroupId])
}
