model AcademicTerm {
  id       String     @id @default(cuid())
  season   TermSeason
  year     Int
  startsOn DateTime
  endsOn   DateTime

  transcriptEntries  TranscriptEntry[]
  plannedTerms       PlannedTerm[]
  graduatingStudents StudentProfile[] @relation("ExpectedGraduation")
  studentsNotTaking  StudentProfile[] @relation("NotTakingTerm")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([season, year])
}

model Course {
  id          String       @id @default(cuid())
  subject     String // "CST", "MATH", "MGMT"
  number      String // "140", "110"
  title       String
  credits     Int
  description String?
  isLab       Boolean      @default(false)
  /// Catalog typically-offered seasons (F/S/SS → FALL/SPRING/SUMMER)
  offeredIn   TermSeason[] @default([])

  attributes          CourseAttribute[]
  requirementItems    RequirementItem[]
  transcriptEntries   TranscriptEntry[]
  plannedCourses      PlannedCourse[]
  recommendedIn       RecommendedTermCourse[]
  prerequisiteGroups  PrerequisiteGroup[]
  requiredBy          CoursePrerequisite[] @relation("PrerequisiteOption")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, number])
  @@index([subject])
}

model CourseAttribute {
  id            String      @id @default(cuid())
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  catalogYearId String
  catalogYear   CatalogYear @relation(fields: [catalogYearId], references: [id], onDelete: Cascade)
  tag           GenEdTag

  @@unique([courseId, catalogYearId, tag])
  @@index([catalogYearId, tag])
}

/// One AND-clause of a course's prerequisites or corequisites.
/// Options inside the group are alternatives: any one of them satisfies the group.
model PrerequisiteGroup {
  id           String               @id @default(cuid())
  courseId     String
  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isConcurrent Boolean              @default(false)
  sortOrder    Int                  @default(0)
  /// Catalog text that completed courses cannot prove: scores, standing, consent, or "or higher".
  note         String?
  options      CoursePrerequisite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model CoursePrerequisite {
  id         String            @id @default(cuid())
  groupId    String
  group      PrerequisiteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requiresId String
  requires   Course            @relation("PrerequisiteOption", fields: [requiresId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, requiresId])
  @@index([requiresId])
}
