{
  "name": "aggietrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"next dev\" \"email dev --dir react-email-starter/emails --port 4000\"",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:preview": "if [ \"$SEED_ON_DEPLOY\" = \"true\" ]; then prisma db seed; else echo \"Skipping seed (SEED_ON_DEPLOY is not true)\"; fi",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && pnpm run seed:preview && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@uidotdev/usehooks": "^2.4.1",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.5",
    "react-hook-form": "^7.87.0",
    "resend": "^6.28.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.5.1"
}