TEST_MANAGER_AUTH_URL=http://127.0.0.1:3001
# Personal email seeded as the unverified admin. That person claims it on first sign-in.
TEST_MANAGER_ADMIN_EMAIL=
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEST_MANAGER_AUTH_SECRET=
# Resend API key and a sender address on your verified Resend domain.
TEST_MANAGER_RESEND_KEY=
TEST_MANAGER_EMAIL_FROM=AggieTrack Test Manager <noreply@aggietrack.space>
# Optional dedicated SQLite file; default is prisma/test-manager.db.
# TEST_MANAGER_DATABASE_URL=file:/absolute/path/test-manager.db
# AggieTrack origin for fictional student reset. Local default is http://127.0.0.1:3000.
# Set the same password and secret on AggieTrack for local and preview. Leave them unset on the live site.
AGGIETRACK_ORIGIN=http://127.0.0.1:3000
TEST_STUDENT_PASSWORD=
TEST_STUDENT_RESET_SECRET=
